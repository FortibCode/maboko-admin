# Adresse du serveur de l'API.
#
# Le chemin des routes (« /api/v1 ») est ajouté par le back-office lui-même :
# l'adresse du serveur suffit ici, avec ou sans ce chemin.
#
# Sans ce fichier, le back-office vise l'API en ligne :
#   https://maboko-api.onrender.com
#
# Copiez ce fichier en « .env.local » pour viser un backend local :
NEXT_PUBLIC_API_URL=http://localhost:8000
